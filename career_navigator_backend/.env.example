# FastAPI Career Navigator Backend - Environment Variables Example
# Copy this file to ".env" and adjust values as needed.

# Database configuration (SQLite by default; path relative to container root)
# DATABASE_URL=sqlite:///./data/app.db

# CORS configuration
# When true, allow all origins with wildcard and disable credentials (required by CORS spec for "*").
# Recommended for local development and preview environments.
ALLOW_ALL_CORS=true

# When ALLOW_ALL_CORS is false, specify allowed origins as a comma-separated list.
# Example:
# ALLOWED_CORS_ORIGINS=http://localhost:3000,https://your-preview-domain:3000

# Optional: override defaults entirely even when not using wildcard
# ALLOWED_CORS_ORIGINS=http://localhost:3000,https://vscode-internal-11652-beta.beta01.cloud.kavia.ai:3000
